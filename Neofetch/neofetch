#!/bin/bash

# Colores para el texto
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
WHITE='\033[1;37m'
RESET='\033[0m'

# Función para obtener información del sistema
get_distro() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        echo "$NAME $VERSION"
    else
        echo "Desconocido"
    fi
}

get_kernel() {
    uname -r
}

get_uptime() {
    uptime -p | sed 's/up //'
}

get_packages() {
    # Detecta el gestor de paquetes y cuenta paquetes
    if command -v dpkg &> /dev/null; then
        dpkg -l 2>/dev/null | wc -l
    elif command -v rpm &> /dev/null; then
        rpm -qa 2>/dev/null | wc -l
    elif command -v pacman &> /dev/null; then
        pacman -Q 2>/dev/null | wc -l
    else
        echo "?"
    fi
}

get_shell() {
    basename "$SHELL"
}

get_desktop() {
    echo "${XDG_CURRENT_DESKTOP:-$DESKTOP_SESSION}"
}

get_cpu() {
    CPU=$(lscpu | grep "Model name" | cut -d':' -f2 | xargs)
    echo "${CPU:-Desconocido}"
}

get_ram() {
    total=$(free -h | awk '/^Mem:/ {print $2}')
    used=$(free -h | awk '/^Mem:/ {print $3}')
    echo "${used} / ${total}"
}

get_gpu() {
    GPU=$(lspci | grep -E "VGA|3D" | cut -d':' -f3 | xargs | head -n1)
    echo "${GPU:-Integrada}"
}

# Función principal que muestra logo + info
show_fetch() {
    # Configuración del logo (cambia esta ruta)
    LOGO_PATH="/usr/share/pixmaps/logo.png"  # Logo por defecto
    # O usa un logo específico de tu distro
    # LOGO_PATH="/usr/share/backgrounds/distro-logo.png"
    
    # Alternativas de logos según distro
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        case "$ID" in
            ubuntu) LOGO_PATH="/usr/share/pixmaps/ubuntu-logo.png" ;;
            debian) LOGO_PATH="/usr/share/pixmaps/debian-logo.png" ;;
            arch) LOGO_PATH="/usr/share/pixmaps/archlinux-logo.png" ;;
            fedora) LOGO_PATH="/usr/share/pixmaps/fedora-logo.png" ;;
        esac
    fi
    
    # Opción 1: Mostrar logo a la izquierda y texto a la derecha
    # Esto requiere guardar la salida de chafa en una variable temporal
    temp_file=$(mktemp)
    chafa --size=40x20 --colors=256 "$LOGO_PATH" > "$temp_file"
    
    # Leer el logo línea por línea
    logo_lines=()
    while IFS= read -r line; do
        logo_lines+=("$line")
    done < "$temp_file"
    rm "$temp_file"
    
    # Información del sistema
    distro=$(get_distro)
    kernel=$(get_kernel)
    uptime=$(get_uptime)
    pkgs=$(get_packages)
    shell_name=$(get_shell)
    desktop=$(get_desktop)
    cpu=$(get_cpu)
    ram=$(get_ram)
    gpu=$(get_gpu)
    
    # Crear líneas de información formateadas
    info_lines=(
        "${CYAN}┌────────────────────────────────────────┐${RESET}"
        "${GREEN}   OS:${RESET} $distro"
        "${GREEN}   Kernel:${RESET} $kernel"
        "${GREEN}   Uptime:${RESET} $uptime"
        "${GREEN}   Packages:${RESET} $pkgs"
        "${GREEN}   Shell:${RESET} $shell_name"
        "${GREEN}   DE/WM:${RESET} $desktop"
        "${GREEN}   CPU:${RESET} $cpu"
        "${GREEN}   GPU:${RESET} $gpu"
        "${GREEN}   RAM:${RESET} $ram"
        "${CYAN}└────────────────────────────────────────┘${RESET}"
    )
    
    # Mostrar logo junto a la información
    max_lines=$(( ${#logo_lines[@]} > ${#info_lines[@]} ? ${#logo_lines[@]} : ${#info_lines[@]} ))
    
    for ((i=0; i<max_lines; i++)); do
        # Obtener línea del logo o espacio vacío
        if [ $i -lt ${#logo_lines[@]} ]; then
            logo_part="${logo_lines[$i]}"
        else
            logo_part=$(printf "%*s" "${#logo_lines[0]}" "")
        fi
        
        # Obtener línea de info o espacio vacío
        if [ $i -lt ${#info_lines[@]} ]; then
            info_part="${info_lines[$i]}"
        else
            info_part=""
        fi
        
        # Imprimir ambas columnas
        echo -e "$logo_part    $info_part"
    done
}

# Versión más simple: solo mostrar logo arriba e info abajo
show_fetch_simple() {
    LOGO_PATH="/usr/share/pixmaps/logo.png"
    
    # Mostrar logo centrado
    echo -e "${BLUE}"
    chafa --size=50x25 --center "$LOGO_PATH"
    echo -e "${RESET}"
    
    # Mostrar información del sistema
    echo -e "${GREEN}"
    echo "    OS:        $(get_distro)"
    echo "    Kernel:    $(get_kernel)"
    echo "    Uptime:    $(get_uptime)"
    echo "    Packages:  $(get_packages)"
    echo "    Shell:     $(get_shell)"
    echo "    Desktop:   $(get_desktop)"
    echo "    CPU:       $(get_cpu)"
    echo "    RAM:       $(get_ram)"
    echo "    GPU:       $(get_gpu)"
    echo -e "${RESET}"
}

# Ejecutar
show_fetch
